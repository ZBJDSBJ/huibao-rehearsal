# ===== AI（DeepSeek）=====
# 获取：https://platform.deepseek.com 注册 → 创建 API Key（按量计费，极便宜）
DEEPSEEK_API_KEY=

# ===== Supabase（账号 + 数据库 + 云端同步）=====
# 获取：https://supabase.com 注册 → 新建项目 → Settings → API
# 然后在 SQL Editor 执行 supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Stripe（支付）=====
# 获取：https://dashboard.stripe.com → 开发者 → API 密钥
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 在 Stripe 建 Product+Price 后填入价格 ID（月付 / 年付）
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ===== 站点地址 =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
